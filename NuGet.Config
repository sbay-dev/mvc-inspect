<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-level NuGet config: allows test packages from nuget.org
  without inheriting the global PackageSourceMapping restrictions.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
