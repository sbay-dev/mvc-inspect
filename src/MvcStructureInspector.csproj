<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>mvc-inspect</AssemblyName>
    <RootNamespace>MvcStructureInspector</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mvc-inspect</ToolCommandName>
    <Version>2.7.0</Version>
    <PackageId>MvcStructureInspector</PackageId>
    <Title>MVC Structure Inspector — Static Structural Analysis for ASP.NET Core</Title>
    <Description>A Roslyn-powered .NET global CLI tool for static structural analysis of ASP.NET Core MVC projects. Generates comprehensive Abstract Syntax Tree traversals, gap analysis reports, and developer checklists across C# source files, Razor views, static assets (wwwroot), project files (.csproj/.sln), snapshot-based drift detection, and intelligent .gitignore generation with multi-ecosystem detection.</Description>
    <Authors>SBAY-SDK</Authors>
    <Company>SBAY-SDK</Company>
    <Copyright>Copyright © 2025-2026 SBAY-SDK</Copyright>
    <PackageTags>mvc;aspnetcore;roslyn;static-analysis;code-analysis;gap-analysis;dotnet-tool;csharp;razor;structural-inspection;gitignore</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://sbay-dev.github.io/mvc-inspect/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sbay-dev/mvc-inspect</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>v2.7.0: Intelligent .gitignore generator with multi-ecosystem detection (15+ project types), nested/hybrid project awareness, safe merge with existing .gitignore, custom pattern support, preview mode. 93 unit tests.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
